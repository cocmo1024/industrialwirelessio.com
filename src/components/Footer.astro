---
/**
 * Footer — H9 of the portal front page (blueprint R1.2): a section
 * index above the brand-facts line. The facts line itself is
 * unchanged (GEO List B-08): site name, positioning, contact email
 * and an About link, plus the cluster and sourcing sentences. Every
 * string is read from src/data/brand.ts — the single source of truth
 * (B-13); nothing is hand-written here.
 */
import { brand } from '../data/brand';

const indexLinks = [
	...brand.portalSections,
	{ label: 'Data Center', path: '/data-center/' },
	{ label: 'Product Database', path: '/product-families/' },
	{ label: 'Tools', path: '/tools/' },
	{ label: 'Vendor Directory', path: '/vendors/' },
];
---

<footer class="site-footer">
	<div class="footer-inner">
		<nav class="footer-index" aria-label="Site index">
			<ul>
				{
					indexLinks.map((link) => (
						<li>
							<a href={link.path}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="facts-line">
			<strong>{brand.name}</strong> — {brand.positioning}
		</p>
		<p>{brand.cluster}</p>
		<p>{brand.sourcing}</p>
		<p class="facts-meta">
			Contact: <a href={`mailto:${brand.email}`}>{brand.email}</a>
			· <a href="/about/">About</a>
			· <a href="/contact/">Contact</a>
			· <a href="/editorial-desk/">Editorial desk</a>
			· <a href="/review-desk/">Review desk</a>
			· <a href="/editorial-policy/">Editorial policy</a>
			· <a href="/privacy/">Privacy</a>
			· <a href="/terms-of-use/">Terms of use</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--panel);
		color: var(--ink-2);
		margin-top: 2rem;
	}

	.footer-inner {
		max-width: var(--content-w);
		margin: 0 auto;
		padding: 1rem var(--gutter) 1.4rem;
		font-size: var(--fs-sm);
	}

	.footer-index {
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.7rem;
		margin-bottom: 0.9rem;
	}

	.footer-index ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-index a {
		font-weight: 600;
	}

	.facts-line strong {
		color: var(--ink);
	}

	.facts-meta {
		margin-bottom: 0;
	}
</style>
