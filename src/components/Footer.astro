---
/**
 * Footer — carries the brand-facts line (GEO List B-08): site name,
 * positioning, contact email and an About link, plus the cluster and
 * sourcing sentences. Every string is read from src/data/brand.ts —
 * the single source of truth (B-13); nothing is hand-written here.
 */
import { brand } from '../data/brand';
---

<footer class="site-footer">
	<div class="footer-inner">
		<p class="facts-line">
			<strong>{brand.name}</strong> — {brand.positioning}
		</p>
		<p>{brand.cluster}</p>
		<p>{brand.sourcing}</p>
		<p class="facts-meta">
			Contact: <a href={`mailto:${brand.email}`}>{brand.email}</a>
			· <a href="/about/">About</a>
			· <a href="/editorial-policy/">Editorial policy</a>
			· <a href="/privacy/">Privacy</a>
			· <a href="/terms-of-use/">Terms of use</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: var(--panel);
		color: var(--ink-2);
		margin-top: 2rem;
	}

	.footer-inner {
		max-width: var(--content-w);
		margin: 0 auto;
		padding: 1rem var(--gutter) 1.4rem;
		font-size: var(--fs-sm);
	}

	.facts-line strong {
		color: var(--ink);
	}

	.facts-meta {
		margin-bottom: 0;
	}
</style>
