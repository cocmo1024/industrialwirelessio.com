---
/**
 * Fresnel zone calculator — full tool form (blueprint §2.3 tool
 * anatomy, §4.5 T2, GEO asset A18). Arithmetic runs through the
 * shared engine (src/utils/link-engine.ts), the same module the
 * link budget tool uses. The 60% clearance figure is presented on
 * the page as what it is: a planning convention, not a standard's
 * limit.
 */
---

<form class="calc" data-fresnel novalidate>
	<fieldset>
		<legend>The path</legend>
		<div class="fields">
			<label>
				Frequency (MHz)
				<input type="number" name="frequency" step="any" min="0" inputmode="decimal" required />
			</label>
			<label>
				Total path length
				<span class="with-unit">
					<input type="number" name="distance" step="any" min="0" inputmode="decimal" required />
					<select name="distanceUnit" aria-label="Path length unit">
						<option value="km" selected>km</option>
						<option value="m">m</option>
					</select>
				</span>
			</label>
			<label>
				Obstacle point, distance from end A (optional)
				<span class="with-unit">
					<input type="number" name="obstacle" step="any" min="0" inputmode="decimal" />
					<select name="obstacleUnit" aria-label="Obstacle distance unit">
						<option value="km" selected>km</option>
						<option value="m">m</option>
					</select>
				</span>
				<span class="hint">Leave empty to evaluate the midpoint — where the zone is widest.</span>
			</label>
			<label>
				Clearance at the obstacle (m, optional)
				<input type="number" name="clearance" step="any" inputmode="decimal" />
				<span class="hint">Height of the line of sight above the top of the obstacle. Enter it to get a clearance ratio and a verdict.</span>
			</label>
		</div>
	</fieldset>

	<p class="calc-error" data-error role="alert" hidden></p>

	<section class="results" aria-live="polite" aria-label="Fresnel zone result">
		<div class="empty-state" data-empty>
			<p class="empty-title">No zone computed yet.</p>
			<p class="empty-reason" data-empty-reason>
				The zone geometry needs two figures: frequency and total path length.
			</p>
			<p class="empty-reason">Enter the figures on this page — nothing is uploaded or stored.</p>
		</div>
		<div data-output hidden>
			<dl class="readings">
				<div class="reading">
					<dt>First-zone radius at the obstacle point</dt>
					<dd class="num" data-out="radiusObstacle">–</dd>
				</div>
				<div class="reading">
					<dt>First-zone radius at midpoint</dt>
					<dd class="num" data-out="radiusMid">–</dd>
				</div>
				<div class="reading">
					<dt>60% clearance target at the obstacle point</dt>
					<dd class="num" data-out="clearance60">–</dd>
				</div>
				<div class="reading" data-ratio-row hidden>
					<dt>Your clearance as % of the first zone</dt>
					<dd class="num" data-out="ratio">–</dd>
				</div>
			</dl>
			<p class="verdict" data-verdict-wrap hidden>
				<strong data-verdict-label></strong>
				<span data-verdict-detail></span>
			</p>
		</div>
	</section>
</form>

<script>
	import { computeFresnel, fmtDb, fmtM } from '../utils/link-engine';

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-fresnel]')) {
		const field = (name: string) =>
			form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
		const raw = (name: string) => field(name)?.value.trim() ?? '';
		const num = (name: string): number | undefined => {
			const value = raw(name);
			if (value === '') return undefined;
			const parsed = Number(value);
			return Number.isFinite(parsed) ? parsed : undefined;
		};
		const toMetres = (value: number, unit: string) => (unit === 'km' ? value * 1000 : value);
		const errorBox = form.querySelector<HTMLElement>('[data-error]');
		const emptyBox = form.querySelector<HTMLElement>('[data-empty]');
		const emptyReason = form.querySelector<HTMLElement>('[data-empty-reason]');
		const output = form.querySelector<HTMLElement>('[data-output]');
		const out = (key: string) => form.querySelector<HTMLElement>(`[data-out="${key}"]`);
		const ratioRow = form.querySelector<HTMLElement>('[data-ratio-row]');
		const verdictWrap = form.querySelector<HTMLElement>('[data-verdict-wrap]');
		const verdictLabel = form.querySelector<HTMLElement>('[data-verdict-label]');
		const verdictDetail = form.querySelector<HTMLElement>('[data-verdict-detail]');

		function showError(message: string) {
			if (errorBox) {
				errorBox.textContent = message;
				errorBox.hidden = false;
			}
			if (output) output.hidden = true;
			if (emptyBox) emptyBox.hidden = true;
		}

		function update() {
			const missing: string[] = [];
			if (num('frequency') === undefined) missing.push('frequency');
			if (num('distance') === undefined) missing.push('total path length');
			if (missing.length > 0) {
				if (errorBox) errorBox.hidden = true;
				if (output) output.hidden = true;
				if (emptyBox) emptyBox.hidden = false;
				if (emptyReason) {
					emptyReason.textContent = `Still needed: ${missing.join(' and ')}. The obstacle point and clearance fields are optional.`;
				}
				return;
			}
			try {
				const pathLengthM = toMetres(num('distance') ?? 0, raw('distanceUnit'));
				const obstacleRaw = num('obstacle');
				const result = computeFresnel({
					frequencyMhz: num('frequency') ?? 0,
					pathLengthM,
					obstacleFromAM:
						obstacleRaw === undefined
							? undefined
							: toMetres(obstacleRaw, raw('obstacleUnit')),
					clearanceM: num('clearance'),
				});
				if (errorBox) errorBox.hidden = true;
				if (emptyBox) emptyBox.hidden = true;
				if (output) output.hidden = false;
				const radiusObstacle = out('radiusObstacle');
				if (radiusObstacle) radiusObstacle.textContent = `${fmtM(result.radiusAtObstacleM)} m`;
				const radiusMid = out('radiusMid');
				if (radiusMid) radiusMid.textContent = `${fmtM(result.radiusAtMidpointM)} m`;
				const clearance60 = out('clearance60');
				if (clearance60) clearance60.textContent = `${fmtM(result.clearance60AtObstacleM)} m`;
				const hasRatio = result.clearanceRatioPct !== undefined && result.verdict;
				if (ratioRow) ratioRow.hidden = !hasRatio;
				if (verdictWrap) verdictWrap.hidden = !hasRatio;
				if (hasRatio) {
					const ratio = out('ratio');
					if (ratio) ratio.textContent = `${fmtDb(result.clearanceRatioPct ?? 0, 1)} %`;
					if (verdictLabel && result.verdict) {
						verdictLabel.textContent = `${result.verdict.label}.`;
						verdictLabel.dataset.state = result.verdict.state;
					}
					if (verdictDetail && result.verdict) {
						verdictDetail.textContent = ` ${result.verdict.detail}`;
					}
				}
			} catch (error) {
				showError(
					error instanceof RangeError
						? `Check the figures: ${error.message}.`
						: 'The figures could not be computed — check for empty or non-numeric fields.',
				);
			}
		}

		form.addEventListener('input', update);
		form.addEventListener('change', update);
		update();
	}
</script>

<style>
	.calc fieldset {
		border: 1px solid var(--line);
		border-radius: var(--r-md);
		margin: 0 0 1rem;
		padding: 0.9rem 1rem 1rem;
	}

	.calc legend {
		font-size: var(--fs-sm);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
		padding: 0 0.4rem;
	}

	.fields {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1.2rem;
	}

	.fields > label {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-size: var(--fs-sm);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-2);
		min-width: 11rem;
		flex: 1 1 11rem;
	}

	.fields input[type='number'] {
		font: inherit;
		font-size: var(--fs-md);
		letter-spacing: normal;
		text-transform: none;
		color: var(--ink);
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--r-sm);
		background: var(--card, transparent);
		width: 100%;
	}

	.with-unit {
		display: flex;
		gap: 0.4rem;
	}

	.with-unit input {
		flex: 1;
	}

	.with-unit select {
		font: inherit;
		font-size: var(--fs-md);
		letter-spacing: normal;
		text-transform: none;
		color: var(--ink);
		padding: 0.4rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--r-sm);
		background: var(--card, transparent);
	}

	.hint {
		font-size: var(--fs-sm);
		letter-spacing: normal;
		text-transform: none;
		color: var(--ink-2);
	}

	.calc-error {
		border: 1px solid var(--err);
		background: var(--err-soft);
		color: var(--ink);
		border-radius: var(--r-sm);
		padding: 0.6rem 0.8rem;
	}

	.results {
		border: 1px solid var(--line);
		border-radius: var(--r-md);
		padding: 0.9rem 1rem;
	}

	.readings {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		margin: 0 0 0.8rem;
	}

	.reading dt {
		font-size: var(--fs-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.reading dd {
		margin: 0.15rem 0 0;
		font-size: var(--fs-xl);
	}

	.verdict {
		margin: 0;
		max-width: 72ch;
	}

	.verdict strong[data-state='ok'] {
		color: var(--ok);
	}

	.verdict strong[data-state='warn'] {
		color: var(--warn);
	}

	.verdict strong[data-state='err'] {
		color: var(--err);
	}
</style>
